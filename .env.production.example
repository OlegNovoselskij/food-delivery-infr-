# Copy to .env.production on the server and fill in. Never commit the filled file.
# Secrets: openssl rand -hex 32

FRONTEND_DOMAIN=atrium.arsenhome.win
API_DOMAIN=api.arsenhome.win
ACME_EMAIL=rnovoselskijoleh@gmail.com

POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_SESSION_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=atrium-private
R2_PUBLIC_BUCKET=atrium-public
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# console = verification codes are printed to the worker log instead of being emailed
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
RESEND_API_KEY=

GOOGLE_CLIENT_ID=

# Cost guards (defaults keep us inside the free tiers of R2 and Resend)
# Total size of lessons videos, materials and covers; new uploads are refused above it. 8 GiB of the 10 GB R2 free tier
STORAGE_QUOTA_BYTES=8589934592
# Presigned uploads carry the declared file size, so the storage rejects a file of another size. Keep true
S3_SIGN_CONTENT_LENGTH=true
# Emails sent per UTC day; the rest waits in the queue for the next day. 0 = no limit. Resend free tier is 100 a day
EMAIL_DAILY_LIMIT=90

# Used by CI later; leave unset for the first manual deploy (images are built on the server)
BACKEND_IMAGE=
FRONTEND_IMAGE=
